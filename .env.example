# Supabase 프로젝트 설정 (https://supabase.com/dashboard 에서 확인)
# 1) 새 프로젝트 생성 → 2) schema.sql을 SQL Editor에서 실행 → 3) 아래 두 값을 복사
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# 참고: Authentication > Sign-in / Sign-ups에서 "Allow anonymous sign-ins"를 켜야
# 익명 로그인이 동작합니다. (개인 앱이라 별도 회원가입 없이 기기별 익명 유저로 시작)

# 선택: 이메일 확인 링크 복귀 주소. 미설정이면 현재 앱 origin을 사용합니다.
# 프리뷰/운영의 정확한 주소를 Supabase Auth Redirect URLs에 각각 등록하세요.
# NEXT_PUBLIC_AUTH_REDIRECT_URL=https://your-exact-preview.vercel.app/
